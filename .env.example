# Optional: Gemini API key for neural TTS voices & AI Tutor
# If omitted or credits are depleted, the app automatically falls back to native pt-BR Web Speech TTS and built-in geometric tutor explanations.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Turso / LibSQL or Postgres connection for cloud sync across devices
# Works offline-first via IndexedDB/localStorage by default
DATABASE_URL=
